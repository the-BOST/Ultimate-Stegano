<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ultimate Stegano — {{ filename }}</title>
<style>
  :root{
    --bg:#0f1117; --panel:#171a23; --panel2:#1e222d; --border:#2a2f3c;
    --fg:#e6e8ee; --muted:#8b93a7; --accent:#6ea8fe;
    --high:#ff5c7a; --medium:#ffb020; --low:#56d364; --flag:#c678ff;
  }
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){
      --bg:#f6f7fa; --panel:#fff; --panel2:#eef0f5; --border:#d8dbe4;
      --fg:#1c1f27; --muted:#5c6475; --accent:#2b6fd6;
    }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
    font:15px/1.55 ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
  .wrap{max-width:1000px;margin:0 auto;padding:32px 16px 72px}
  header{border-bottom:1px solid var(--border);padding-bottom:18px;margin-bottom:24px}
  h1{font-size:22px;margin:0 0 4px}
  h2{font-size:17px;margin:28px 0 12px;color:var(--accent)}
  .sub{color:var(--muted);font-size:13px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}
  .card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:14px}
  .card .k{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.04em}
  .card .v{font-size:18px;font-weight:600;margin-top:4px;word-break:break-all}
  table{width:100%;border-collapse:collapse;background:var(--panel);
    border:1px solid var(--border);border-radius:10px;overflow:hidden}
  th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:top}
  th{background:var(--panel2);font-size:12px;text-transform:uppercase;color:var(--muted)}
  tr:last-child td{border-bottom:none}
  .badge{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600}
  .high{background:color-mix(in srgb,var(--high) 22%,transparent);color:var(--high)}
  .medium{background:color-mix(in srgb,var(--medium) 22%,transparent);color:var(--medium)}
  .low{background:color-mix(in srgb,var(--low) 22%,transparent);color:var(--low)}
  .flagbox{background:color-mix(in srgb,var(--flag) 14%,transparent);
    border:1px solid color-mix(in srgb,var(--flag) 45%,transparent);
    border-radius:10px;padding:14px 16px;margin:4px 0}
  .flag{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--flag);
    font-size:15px;font-weight:700;word-break:break-all}
  code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    background:var(--panel2);padding:1px 6px;border-radius:5px;font-size:13px}
  .empty{color:var(--muted);font-style:italic}
  a{color:var(--accent)}
  footer{margin-top:40px;color:var(--muted);font-size:12px;
    border-top:1px solid var(--border);padding-top:16px}
</style>
</head>
<body><div class="wrap">
  <header>
    <h1>🔍 Ultimate Stegano report</h1>
    <div class="sub">Target: <code>{{ filename }}</code> · generated {{ generated }}</div>
  </header>

  <div class="grid">
    <div class="card"><div class="k">File type</div><div class="v">{{ filetype }}</div></div>
    <div class="card"><div class="k">Size</div><div class="v">{{ filesize }}</div></div>
    <div class="card"><div class="k">MIME</div><div class="v">{{ mime }}</div></div>
    <div class="card"><div class="k">Entropy</div><div class="v">{{ entropy }}</div></div>
    <div class="card"><div class="k">SHA-256</div><div class="v" style="font-size:12px">{{ sha256 }}</div></div>
    <div class="card"><div class="k">Findings</div><div class="v">{{ findings|length }}</div></div>
  </div>

  <h2>🚩 Recovered flags</h2>
  {% if flags %}
    {% for f in flags %}<div class="flagbox"><span class="flag">{{ f }}</span></div>{% endfor %}
  {% else %}
    <p class="empty">No flag-like strings recovered automatically. Review the
      artifacts below (spectrograms, bit-planes, carved files) by hand.</p>
  {% endif %}

  <h2>📋 Findings</h2>
  {% if findings %}
  <table>
    <tr><th>Category</th><th>Detail</th><th>Confidence</th><th>Artifacts</th></tr>
    {% for f in findings %}
    <tr>
      <td>{{ f.category }}</td>
      <td>{{ f.detail }}
        {% if f.flags %}<br>{% for fl in f.flags %}<code>{{ fl }}</code> {% endfor %}{% endif %}
      </td>
      <td><span class="badge {{ f.confidence }}">{{ f.confidence }}</span></td>
      <td>{% for a in f.artifacts %}<a href="{{ a }}">{{ a }}</a><br>{% endfor %}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
    <p class="empty">No structured findings.</p>
  {% endif %}

  <h2>🗂 Output tree</h2>
  <p class="sub">All artifacts are under <code>{{ outdir }}</code>.</p>

  <footer>Generated by Ultimate Stegano v{{ version }} — multi-format
    steganography analyzer for CTF &amp; forensics.</footer>
</div></body>
</html>
